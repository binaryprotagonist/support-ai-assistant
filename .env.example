# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
# Leave MONGODB_URI empty to automatically use in-memory MongoDB for tests and local zero-friction setup!
MONGODB_URI=

# Primary Provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Fallback Provider (Grok / xAI)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

# Per-request Hard Budget & Reliability Config
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=3
MAX_COST_PER_REQUEST_USD=0.05
MAX_TOKENS_PER_REQUEST=4000

# LangSmith / Langfuse Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-assistant-production
